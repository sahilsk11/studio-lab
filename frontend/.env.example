# Local dev (default when unset): http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# Clerk — required in production so the API can reject unsigned video generation.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Production (Cloudflare Pages build): leave empty for same-origin /api via Pages Functions
# EXPO_PUBLIC_API_URL=
